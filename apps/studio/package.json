{
  "name": "felilegium",
  "private": true,
  "type": "module",
  "description": "Turn a post into pages or a carousel: draw text boxes, and a cat gym, an oak or florilegium's flowers grow around them",
  "scripts": {
    "sync": "node scripts/sync-lua.mjs",
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@chenglou/pretext": "1.0.0",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.6.0",
    "typescript": "5.8.3",
    "vite": "7.0.0"
  }
}
